# Data is never committed: it is large, and it is reproducible from public sources.
data/**
!data/**/
!data/**/.gitkeep
!data/manifest.json
outputs/**
!outputs/.gitkeep

# Secrets
.env
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Claude Code local overrides
.claude/settings.local.json

# OS
Thumbs.db
.DS_Store

# Ad-hoc run logs (e.g. backfill_*.log from a long-running pipeline job)
*.log

# Personal, non-committed notes
*.local.md
