---
import '../styles/global.css';
import 'flag-icons/css/flag-icons.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANGS, localePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** path after the language segment, e.g. "explore/" */
  path: string;
  title?: string;
  description?: string;
  /** "app": full-viewport map page, header overlaid, no footer */
  mode?: 'page' | 'app';
  /** Share card (public/og/<lang>-<og>.jpg, made by scripts/og-images.mjs) */
  og?: 'story' | 'shadow' | 'site';
}

const { lang, path, title, description, mode = 'page', og = 'site' } = Astro.props;
const siteName = t(lang, 'site.name');
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const desc = description ?? t(lang, 'site.description');
const absolute = (href: string) => new URL(href, Astro.site).href;
// Cloudflare Web Analytics (no cookies): only when the public token is set in .env.production.
const beacon = import.meta.env.PUBLIC_CF_BEACON as string | undefined;
---

<!doctype html>
<html lang={lang} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#04080f" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={absolute(localePath(lang, path))} />
    <link rel="canonical" href={absolute(localePath(lang, path))} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:image" content={absolute(`/og/${lang}-${og}.jpg`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={absolute(`/og/${lang}-${og}.jpg`)} />
    {beacon && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={absolute(localePath(l, path))} />)}
  </head>
  <body class:list={[`mode-${mode}`]}>
    <Header lang={lang} path={path} overlay={mode === 'app'} />
    <main>
      <slot />
    </main>
    {mode === 'page' && <Footer lang={lang} />}
  </body>
</html>

<style is:global>
  body.mode-app {
    height: 100dvh;
    overflow: hidden;
  }

  body.mode-app main {
    position: fixed;
    inset: 0;
  }
</style>
