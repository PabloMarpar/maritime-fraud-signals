---
import Logo from './Logo.astro';
import { localePath, t, type Lang, LANGS } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** path after the language segment, e.g. "explore/" */
  path: string;
  overlay?: boolean;
}

const { lang, path, overlay = false } = Astro.props;
const links = [
  { key: 'nav.story', href: '' },
  { key: 'nav.shadow', href: 'shadow-fleet/' },
  { key: 'nav.explore', href: 'explore/' },
  { key: 'nav.live', href: 'live/' },
  { key: 'nav.vessels', href: 'vessels/' },
  { key: 'nav.about', href: 'about/' },
] as const;
const current = path.replace(/^\/+/, '');
const isActive = (href: string) =>
  href === '' ? current === '' : current.startsWith(href) || (href === 'vessels/' && current.startsWith('vessel/'));
---

<header class:list={['site-header', { overlay }]}>
  <a class="brand" href={localePath(lang)} aria-label={t(lang, 'site.name')}>
    <Logo />
    <span class="brand-name">{t(lang, 'site.name')}</span>
  </a>

  <nav class="nav" aria-label="Main">
    {
      links.map((l) => (
        <a href={localePath(lang, l.href)} class:list={['nav-link', { active: isActive(l.href) }]}>
          {l.key === 'nav.live' && <span class="live-dot" aria-hidden="true" />}
          {t(lang, l.key)}
        </a>
      ))
    }
  </nav>

  <div class="lang" role="group" aria-label={t(lang, 'nav.language')}>
    {
      LANGS.map((l) => (
        <a
          href={localePath(l, current)}
          class:list={['lang-link', { active: l === lang }]}
          hreflang={l}
          lang={l}
          data-lang-switch
        >
          {l.toUpperCase()}
        </a>
      ))
    }
  </div>

  <button class="menu-btn icon-btn" aria-label={t(lang, 'nav.menu')} aria-expanded="false" data-menu-btn>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
  </button>
</header>

<script>
  // Keep the query string (e.g. ?mmsi=…) when switching language.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      if (location.search) a.href = a.href.split('?')[0] + location.search;
      try {
        localStorage.setItem('lang', a.lang);
      } catch {}
    });
  });
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  btn?.addEventListener('click', () => {
    const header = btn.closest('.site-header')!;
    const open = header.classList.toggle('menu-open');
    btn.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
    padding: 0 var(--gutter);
    background: rgba(4, 8, 15, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }

  .site-header.overlay {
    position: fixed;
    inset: 0 0 auto 0;
    background: linear-gradient(to bottom, rgba(4, 8, 15, 0.85), rgba(4, 8, 15, 0.35));
    border-bottom-color: transparent;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex: none;
  }

  .brand-name {
    font-weight: 650;
    font-size: 14.5px;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .nav-link:hover {
    color: var(--text-1);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-link.active {
    color: var(--text-1);
    background: rgba(255, 255, 255, 0.08);
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--s-good);
    box-shadow: 0 0 0 0 rgba(12, 163, 12, 0.6);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(12, 163, 12, 0.55);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(12, 163, 12, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(12, 163, 12, 0);
    }
  }

  .lang {
    display: flex;
    padding: 3px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    flex: none;
  }

  .lang-link {
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.06em;
    color: var(--text-3);
    text-decoration: none;
  }

  .lang-link.active {
    background: var(--text-1);
    color: var(--bg-0);
  }

  .menu-btn {
    display: none;
  }

  @media (max-width: 820px) {
    .site-header {
      gap: 12px;
    }
    .brand-name {
      display: none;
    }
    .menu-btn {
      display: inline-grid;
      order: 3;
    }
    .lang {
      margin-left: auto;
    }
    .nav {
      position: absolute;
      top: calc(var(--header-h) - 1px);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 2px;
      padding: 10px var(--gutter) 16px;
      background: rgba(4, 8, 15, 0.96);
      border-bottom: 1px solid var(--line);
      display: none;
    }
    .menu-open .nav {
      display: flex;
    }
    .nav-link {
      height: 42px;
      font-size: 15px;
    }
  }
</style>
