---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  class="logo"
>
  <defs>
    <linearGradient id="logo-g" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#3987e5"></stop>
      <stop offset="1" stop-color="#199e70"></stop>
    </linearGradient>
  </defs>
  <circle cx="16" cy="16" r="14.5" stroke="url(#logo-g)" stroke-opacity="0.55"></circle>
  <circle cx="16" cy="16" r="9" stroke="url(#logo-g)" stroke-opacity="0.35"></circle>
  <path d="M4 19.5c3-2.4 6-2.4 9 0s6 2.4 9 0 4.8-2 6.5-1" stroke="#eef2f7" stroke-width="1.8" stroke-linecap="round"></path>
  <path d="M16 16 26 8.5" stroke="url(#logo-g)" stroke-width="1.8" stroke-linecap="round"></path>
  <circle cx="22.6" cy="11" r="2.2" fill="#d95926"></circle>
</svg>
