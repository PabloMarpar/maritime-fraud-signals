---
import { LANGS, DEFAULT_LANG } from '../i18n/ui';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Maritime Fraud Signals</title>
    <meta name="theme-color" content="#04080f" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline define:vars={{ base, langs: LANGS, fallback: DEFAULT_LANG }}>
      let lang = null;
      try {
        lang = localStorage.getItem('lang');
      } catch (e) {}
      if (!langs.includes(lang)) {
        const prefs = navigator.languages || [navigator.language || ''];
        lang = prefs.some((l) => l.toLowerCase().startsWith('es')) ? 'es' : fallback;
      }
      location.replace(`${base}/${lang}/`);
    </script>
    <style>
      body { background: #04080f; color: #eef2f7; font-family: system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; }
      a { color: inherit; margin: 0 8px; }
    </style>
  </head>
  <body>
    <noscript><a href={`${base}/en/`}>English</a> · <a href={`${base}/es/`}>Español</a></noscript>
  </body>
</html>
