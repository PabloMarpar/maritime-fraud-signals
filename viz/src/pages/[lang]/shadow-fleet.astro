---
import Base from '../../layouts/Base.astro';
import ShadowFleet from '../../islands/ShadowFleet.svelte';
import { SHADOW } from '../../content/shadow';
import { LANGS, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const text = SHADOW[lang];
---

<Base lang={lang} path="shadow-fleet/" title={text.pageTitle} description={text.description} og="shadow">
  <ShadowFleet client:only="svelte" lang={lang} />
</Base>
