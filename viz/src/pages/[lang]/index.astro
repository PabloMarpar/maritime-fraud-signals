---
import Base from '../../layouts/Base.astro';
import { LANGS, localePath, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base lang={lang} path="">
  <section style="padding: 120px var(--gutter); max-width: 900px; margin: 0 auto;">
    <h1 class="serif" style="font-size: 56px; line-height: 1.05; margin: 0 0 20px;">{t(lang, 'site.name')}</h1>
    <p style="color: var(--text-2); font-size: 18px;">{t(lang, 'site.tagline')}</p>
    <p><a class="btn btn-primary" href={localePath(lang, 'explore/')}>{t(lang, 'story.explore')} →</a></p>
  </section>
</Base>
