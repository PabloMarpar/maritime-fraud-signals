---
// Served by Cloudflare for any unknown path (viz/wrangler.jsonc: not_found_handling = 404-page).
// Bilingual, because the language of a broken link is unknown.
import Base from '../layouts/Base.astro';
---

<Base lang="en" path="" title="Page not found · Página no encontrada">
  <section class="nf">
    <p class="code mono">404</p>
    <h1>This page does not exist.</h1>
    <p>Esta página no existe.</p>
    <div class="links">
      <a class="btn btn-primary" href="/en/">Go to the story →</a>
      <a class="btn" href="/es/">Ir a la historia →</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 70dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: calc(var(--header-h) + 40px) var(--gutter) 60px;
    text-align: center;
  }
  .code {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--text-3);
  }
  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 500;
  }
  p {
    margin: 0;
    color: var(--text-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
  }
</style>
